# Keep the build context small and keep secrets and results out of the image.
.git/
.github/
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
runs/
*.log
.env
.env.*
# Reference measurements and price snapshots are analysis inputs, not runtime code.
data/reference_runs/
data/prices/
# Documentation and tests are not needed inside the worker.
docs/
tests/
